#!/usr/bin/python3
"""pg-connections — lihat dan hentikan koneksi PostgreSQL (medusa-postgres).

Pemakaian:
  pg-connections                          ringkasan koneksi, transaksi yang
                                          menunggu lock, dan counter deadlock
  pg-connections cancel <pid>...          batalkan query (pg_cancel_backend)
  pg-connections terminate <pid>...       putus koneksi (pg_terminate_backend)
  pg-connections terminate-app <nama>     putus semua koneksi dengan
                                          application_name tersebut

Koneksi milik medusa-app dan postgres-exporter dilindungi: tidak bisa
dibatalkan atau diputus. psql dijalankan di dalam container memakai
POSTGRES_USER/POSTGRES_DB milik container, jadi tidak ada password di sini.
"""
import json
import re
import sys

from _common import docker, run

CONTAINER = "medusa-postgres"
PROTECTED = ["medusa-app", "postgres-exporter"]

SUMMARY_SQL = """
SELECT json_build_object(
  'max_connections', current_setting('max_connections')::int,
  'client_connections', (SELECT count(*) FROM pg_stat_activity WHERE backend_type = 'client backend'),
  'deadlocks_total', (SELECT deadlocks FROM pg_stat_database WHERE datname = current_database()),
  'groups', (SELECT coalesce(json_agg(g ORDER BY g.count DESC), '[]') FROM (
      SELECT application_name, host(client_addr) AS client_addr, state, count(*) AS count,
             array_agg(pid ORDER BY pid) AS pids
      FROM pg_stat_activity
      WHERE backend_type = 'client backend' AND pid <> pg_backend_pid()
      GROUP BY 1, 2, 3) g),
  'waiting_or_idle_in_tx', (SELECT coalesce(json_agg(w), '[]') FROM (
      SELECT pid, application_name, state, wait_event_type, pg_blocking_pids(pid) AS blocked_by,
             round(extract(epoch FROM now() - xact_start)) AS xact_age_s, left(query, 200) AS query
      FROM pg_stat_activity
      WHERE cardinality(pg_blocking_pids(pid)) > 0 OR state LIKE 'idle in transaction%') w)
);
"""

# {fn} = pg_cancel_backend / pg_terminate_backend, {where} = filter target.
ACTION_SQL = """
SELECT coalesce(json_agg(json_build_object('pid', pid, 'application_name', application_name,
                                           'state', state, 'done', {fn}(pid))), '[]')
FROM pg_stat_activity
WHERE backend_type = 'client backend' AND pid <> pg_backend_pid()
  AND coalesce(host(client_addr), '') <> ALL ({protected}) AND {where};
"""


def psql(sql: str):
    out = docker("exec", "-i", CONTAINER, "sh", "-c",
                 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAq -v ON_ERROR_STOP=1', input=sql)
    return json.loads(out)


def container_ips() -> dict[str, str]:
    out = docker("ps", "--filter", "label=com.docker.compose.project=agentic", "-q")
    ips = {}
    for line in docker("inspect", "-f",
                       "{{.Name}} {{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}",
                       *out.split()).splitlines():
        name, *addrs = line.split()
        for a in addrs:
            ips[a] = name.lstrip("/")
    return ips


def main(args: list[str]):
    ips = container_ips()
    if not args:
        result = psql(SUMMARY_SQL)
        for g in result["groups"]:
            g["client_container"] = ips.get(g["client_addr"] or "", "host/lain")
        result["protected_containers"] = PROTECTED
        return result

    cmd, targets = args[0], args[1:]
    if cmd in ("cancel", "terminate"):
        if not targets or not all(t.isdigit() for t in targets):
            raise ValueError(f"pemakaian: pg-connections {cmd} <pid>...")
        where = f"pid IN ({', '.join(targets)})"
    elif cmd == "terminate-app":
        if len(targets) != 1 or not re.fullmatch(r"[A-Za-z0-9_.-]{1,63}", targets[0]):
            raise ValueError("pemakaian: pg-connections terminate-app <application_name>")
        where = f"application_name = '{targets[0]}'"
    else:
        raise ValueError("perintah tidak dikenal (pakai: cancel, terminate, terminate-app)")

    protected_ips = [ip for ip, name in ips.items() if name in PROTECTED]
    fn = "pg_cancel_backend" if cmd == "cancel" else "pg_terminate_backend"
    arr = "ARRAY[" + ", ".join(f"'{ip}'" for ip in protected_ips) + "]::text[]" if protected_ips else "ARRAY[]::text[]"
    done = psql(ACTION_SQL.format(fn=fn, protected=arr, where=where))
    hit = {str(d["pid"]) for d in done}
    return {"action": fn, "affected": done, "count": len(done),
            "skipped_pids": [t for t in targets if t.isdigit() and t not in hit]}


if __name__ == "__main__":
    sys.exit(run("pg-connections", main))
