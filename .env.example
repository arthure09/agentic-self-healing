# Salin ke .env lalu isi nilainya. .env TIDAK di-commit.
# Buat nilai acak dengan: openssl rand -hex 24

# --- Jaringan ---
# IP Tailscale server; UI (Medusa admin, Grafana) di-bind hanya ke IP ini
TAILSCALE_IP=100.97.181.49

# --- PostgreSQL (Layer 1) ---
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=medusa_db

# --- MedusaJS ---
MEDUSA_JWT_SECRET=CHANGE_ME
MEDUSA_COOKIE_SECRET=CHANGE_ME
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=CHANGE_ME

# --- Grafana (Layer 2) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- alert-bridge -> OpenClaw (Layer 3, diisi setelah OpenClaw terpasang) ---
OPENCLAW_HOOK_URL=http://host.docker.internal:18789/hooks/agent
OPENCLAW_HOOK_TOKEN=CHANGE_ME
OPENCLAW_AGENT_ID=main

# Layer 3: model AI lewat OpenRouter
OPENROUTER_API_KEY=CHANGE_ME
